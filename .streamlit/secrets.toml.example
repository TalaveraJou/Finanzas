# Plantilla de secretos. Copia este archivo a `.streamlit/secrets.toml`
# (ese sí está en .gitignore y NO se sube al repo) y pon tus datos reales.
#
# En Streamlit Community Cloud no se usa este archivo: pega el mismo contenido
# en el panel de la app -> Settings -> Secrets.
#
# Formato RECOMENDADO (por componentes): SQLAlchemy codifica la contraseña, así
# que puedes ponerla tal cual aunque tenga @ : / # o espacios.
# Los valores salen del "Session pooler" de Supabase (Connect -> Session pooler).

DB_HOST = "aws-1-eu-central-1.pooler.supabase.com"
DB_PORT = "5432"
DB_NAME = "postgres"
DB_USER = "postgres.lemeujfydoqctdrsvzbe"
DB_PASSWORD = "tu-password-tal-cual"

# Alternativa: cadena completa (aquí SÍ hay que codificar la contraseña a mano
# si tiene caracteres especiales). Usa una u otra, no ambas.
# DATABASE_URL = "postgresql://postgres.lemeujfydoqctdrsvzbe:TU_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Plantilla de secretos. Copia este archivo a `.streamlit/secrets.toml`
# (ese sí está en .gitignore y NO se sube al repo) y pon tu cadena real.
#
# En Streamlit Community Cloud no se usa este archivo: pega el mismo contenido
# en el panel de la app → Settings → Secrets.
#
# Cadena del "Session pooler" de Supabase (sustituye TU_PASSWORD por la
# contraseña de la base de datos; si tiene caracteres especiales, codifícalos
# en porcentaje, p. ej. @ -> %40).

DATABASE_URL = "postgresql://postgres.lemeujfydoqctdrsvzbe:TU_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
